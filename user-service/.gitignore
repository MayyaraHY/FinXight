# user-service-specific — global rules are in the root .gitignore

# Maven build output
target/
!**/src/main/**/target/
!**/src/test/**/target/
.mvn/wrapper/maven-wrapper.jar
HELP.md

# Spring Boot local secrets (application.properties covered by root)
application-local.properties
application-*-local.properties
src/main/resources/keys/*.pem
src/main/resources/keys/*.key
*.p12
*.jks
