# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; `.env.example` is checked into git as documentation
# of which variables every developer must define.

APP_NAME=Financial AI Engine
ENV=development

DATABASE_URL=postgresql://<user>:<pass>@localhost:5432/financial_db

UPLOAD_DIR=app/uploads
MAX_UPLOAD_SIZE_MB=100

# ---- Service URLs (no defaults — missing values crash backend at startup) ----
# user-service: source of JWT signing keys + /auth/* endpoints.
USER_SERVICE_URL=http://localhost:8080
# ai-service: Gemini-backed chat / anomalies / bilan analysis.
AI_SERVICE_URL=http://localhost:8001

# ---- Third-party API keys ----
GROQ_API_KEY=
