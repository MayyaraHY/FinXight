# ════════════════════════════════════════════════════════════════════
#  ROOT .gitignore — financial_engine mono-repo
#  Covers: Python services, Spring Boot, Next.js, shared tooling
# ════════════════════════════════════════════════════════════════════

# ── Secrets & environment files ──────────────────────────────────────
.env
.env.*
*.env.*
.env.example          # template — no real secrets but excluded from repo
.env*.local           # Next.js local overrides

# ── OS ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE / Editor ─────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.swp

# ── Logs ─────────────────────────────────────────────────────────────
*.log
*.parsing.log
logs/

# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
venv/
.venv/
venv1/
venv_ai/

# ── Data & uploads (user-generated, never commit) ────────────────────
data/
app/uploads/

# ── Project-specific exclusions ──────────────────────────────────────
.claude/
blueprints/
tests/
INTEGRATION_PROGRESS.md
jwt-contract.md

# ── Frontend — Next.js ───────────────────────────────────────────────
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
/.next/
/out/
/build
/coverage
.vercel
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── User Service — Maven / Spring Boot ───────────────────────────────
target/
!**/src/main/**/target/
!**/src/test/**/target/
.mvn/wrapper/maven-wrapper.jar
HELP.md
build/
!**/src/main/**/build/
!**/src/test/**/build/

# Spring / IDE generated
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Spring Boot secrets
application.properties
application-local.properties
application-*-local.properties
src/main/resources/keys/*.pem
src/main/resources/keys/*.key
*.p12
*.jks
*.pem
